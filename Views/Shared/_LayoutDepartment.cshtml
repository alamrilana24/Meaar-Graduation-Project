
<!-- all shared design for all pages here-->

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Meaar</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Meaar5.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/photos/logoMeaar.jpeg" height="70">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse  justify-content-between" id="mainNavbar">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="ManageCources" asp-action="ManageCources">Manage Cources</a>
                        </li>
                        <!--<li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Login" asp-action="index">Login</a> -->

                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <!-- important to display -->
    <div class="container-fluid">
        <div class="row">
            <!-- Side Nav  -->
            <aside class=" side-nav col-12 col-md-3 col-lg-2 border-end min-vh-100 p-3 bg-light">
                <div class="fw-bold mb-3">Quick Access</div>

                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="ManageCources" asp-action="ManageCources">Manage Cources</a>
                    </li>

                    <hr class="my-2">

                    <!--   لو بضيف صفحات زيادة روابط إضافية \
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="" asp-action="Index"></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="" asp-action="Index"></a>
                    </li> -->
                </ul>
            </aside>


            <main class="col-12 col-md-9 col-lg-10 p-4">
                @RenderBody()
            </main>
        </div>
    </div>



    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Meaar - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
